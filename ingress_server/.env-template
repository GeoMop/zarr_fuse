ZF_S3_ACCESS_KEY="key"
ZF_S3_SECRET_KEY="key"
ZF_S3_ENDPOINT_URL="http://localhost:9000"
ZF_STORE_URL="s3://"

# Path to the endpoints config yaml (default: inputs/endpoints_config.yaml)
#CONFIG_PATH=inputs/endpoints_config.yaml

# Ingestion queue: local directory (default) or s3://bucket/prefix (uses ZF_S3_*)
#QUEUE_DIR_PATH=./var/zarr_fuse
#QUEUE_DIR_PATH=s3://bucket/ingress-queue

BASIC_AUTH_USERS_JSON={"test":"test"}

# SMTP password — all other SMTP settings are in endpoints_config.yaml
SMTP_PASSWORD="your_gmail_app_password"
